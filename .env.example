# ---- Frontend (Firebase Web SDK public client configuration — Auth & Firestore only) ----
# Copy this file to .env and fill in your Firebase project values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" during local emulator development/testing.
VITE_USE_FIREBASE_EMULATORS=false

# ---- Server-side / Migration Scripts Only (NEVER expose in frontend or commit) ----
# Option A (recommended): path to downloaded Firebase Service Account JSON
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-drdravid-f4b42.json
#
# Option B: inline service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
